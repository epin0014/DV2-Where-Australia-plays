{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },
  "layer": [
    {
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "data/state_weekly_2025.csv"
            },
            "key": "state",
            "fields": [
              "rate",
              "participants"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "Active every week",
          "scale": {
            "domain": [
              0.64,
              0.79
            ],
            "range": [
              "#CDE3C4",
              "#9CC991",
              "#62A866",
              "#3A8547",
              "#245E31"
            ]
          },
          "legend": {
            "format": ".0%",
            "orient": "bottom-left"
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Active weekly",
            "format": ".1%"
          },
          {
            "field": "participants",
            "type": "quantitative",
            "title": "People (estimate)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "filter": "datum.state != 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.6,
            "lat": -35.6,
            "text": "\u2190 ACT 78%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 12
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Barlow Condensed",
      "fontSize": 18
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3B4246",
      "titleColor": "#5E676D"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3B4246",
      "titleColor": "#5E676D"
    }
  }
}