{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "sport_selection",
      "value": "Australian football",
      "bind": {
        "input": "select",
        "options": [
          "Australian football",
          "Rugby league",
          "Football/soccer",
          "Netball",
          "Cricket",
          "Basketball"
        ],
        "name": "Sport: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF1F2",
        "stroke": "white",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/ausplay_activity_state_2025.csv"
      },
      "transform": [
        {
          "filter": "datum.segment == 'Total' && datum.activity == sport_selection"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state_centroids.csv"
            },
            "key": "state",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#5A6B78",
            "opacity": 0.55,
            "stroke": "#5A6B78",
            "strokeWidth": 1
          },
          "encoding": {
            "size": {
              "field": "participants",
              "type": "quantitative",
              "title": "Adult players",
              "scale": {
                "domain": [
                  0,
                  510000
                ],
                "range": [
                  0,
                  4200
                ]
              },
              "legend": {
                "format": ".2s",
                "orient": "bottom",
                "tickCount": 3
              }
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "activity",
                "type": "nominal",
                "title": "Sport"
              },
              {
                "field": "participants",
                "type": "quantitative",
                "title": "Adult players",
                "format": ","
              },
              {
                "field": "rate",
                "type": "quantitative",
                "title": "Share of adults",
                "format": ".1%"
              },
              {
                "field": "reliability",
                "type": "nominal",
                "title": "Estimate reliability"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -7,
            "fontSize": 11
          },
          "encoding": {
            "text": {
              "field": "state",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": 7,
            "fontSize": 11
          },
          "encoding": {
            "text": {
              "field": "participants",
              "type": "quantitative",
              "format": ".2s"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Barlow Condensed",
      "fontSize": 18
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3B4246",
      "titleColor": "#5E676D"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3B4246",
      "titleColor": "#5E676D"
    }
  }
}